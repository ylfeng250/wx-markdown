{
  "name": "@yanglingfeng/wx-markdown",
  "version": "1.0.0",
  "description": "命令行把 Markdown 转成可粘贴到微信公众号的 HTML",
  "type": "module",
  "bin": {
    "wx-md": "bin/wx-md.js",
    "wx-markdown": "bin/wx-md.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "scripts": {
    "start": "node bin/wx-md.js",
    "serve": "node bin/wx-md.js serve",
    "demo": "node bin/wx-md.js examples/demo.md --no-copy",
    "link": "npm link",
    "prepublishOnly": "node bin/wx-md.js --version"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wechat",
    "weixin",
    "markdown",
    "html",
    "cli",
    "公众号"
  ],
  "author": "yanglingfeng",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@yanglingfeng/wx-markdown",
  "bugs": {
    "url": "https://www.npmjs.com/package/@yanglingfeng/wx-markdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "juice": "^12.1.2",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4"
  }
}
