{
  "name": "wx-markdown",
  "version": "1.0.0",
  "description": "微信发稿台：命令行和网页把 Markdown 转成可粘贴到公众号的 HTML",
  "type": "module",
  "bin": {
    "wx-md": "bin/wx-md.js",
    "wx-markdown": "bin/wx-md.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "scripts": {
    "start": "node bin/wx-md.js",
    "serve": "node bin/wx-md.js serve",
    "build:web": "node scripts/build-web.js",
    "demo": "node bin/wx-md.js examples/demo.md --no-copy",
    "link": "npm link",
    "prepublishOnly": "npm run build:web && node bin/wx-md.js --version"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wechat",
    "weixin",
    "markdown",
    "html",
    "cli",
    "公众号",
    "发稿台"
  ],
  "author": "yanglingfeng",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/wx-markdown",
  "bugs": {
    "url": "https://www.npmjs.com/package/wx-markdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "juice": "^12.1.2",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
